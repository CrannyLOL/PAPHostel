{
  "version": 2,
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/[...path].js"
    },
    {
      "src": "/(?!api)(.*\\.(?:html|css|js|json|png|jpg|jpeg|gif|svg|mp4|webp|woff|woff2|ttf))$",
      "dest": "/public/$1"
    },
    {
      "src": "^/(?!api)(.*)$",
      "dest": "/public/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
